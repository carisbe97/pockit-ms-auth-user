# ============================================================================
# Pockit Finance — pockit-ms-auth-user (.env.example)
# Ambientes Mitologicos:
#   - ares   : DEV Local  -> BD pockit-ares
#   - hermes : QA OCI     -> BD pockit-hermes
#   - zeus   : PROD OCI   -> BD pockit-zeus
# Copia este archivo a .env (ignorado por Git) y completa tus valores.
# ============================================================================

SPRING_PROFILES_ACTIVE=ares
SERVER_PORT=8081

# Supabase Transaction Pooler (:6543) — Runtime HikariCP
DB_URL=jdbc:postgresql://<region>.pooler.supabase.com:6543/postgres?currentSchema=public&sslmode=require&preferQueryMode=simple&application_name=pockit-ms-auth-user
# Supabase Session Pooler (:5432) — Opcional para advisory locks de Flyway
FLYWAY_DB_URL=jdbc:postgresql://<region>.pooler.supabase.com:5432/postgres?currentSchema=public&sslmode=require&application_name=pockit-ms-auth-user-flyway
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=CHANGE_ME

# HikariCP Tuning (evita agotar conexiones en Supabase entre los 4 microservicios)
DB_POOL_MAX=3
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_MAX_LIFETIME_MS=600000
DB_POOL_CONN_TIMEOUT_MS=30000

JPA_DDL_AUTO=validate
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=false

# Swagger / OpenAPI Multi-Server
APP_OPENAPI_SERVER_URL=http://localhost:8081
APP_OPENAPI_SERVER_DESC=Ares - Desarrollo Local
